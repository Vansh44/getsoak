{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_comment": "INERT. Production runs on Cloud Run, where Vercel's cron block does nothing. The real driver is Cloud Scheduler in storemink-prod/asia-south1 — see docs/cron-jobs.md. This file is kept as the record of intended schedules; if you change one here, change the Cloud Scheduler job too, or they silently disagree.",
  "crons": [
    {
      "path": "/api/cron/send-emails",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/plan-expiry",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/expire-pending-payments",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/seo-refresh",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/search-metrics",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/domain-reconcile",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/prune-logs",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/analytics-rollup",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/import-worker",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/help-embeddings",
      "schedule": "50 * * * *"
    }
  ]
}
