{
  "version": 1,
  "baseline": {
    "id": "baseline:cloudsql-2026-08-14",
    "description": "Cloud SQL schema after the platform billing rebuild and before Shiprocket logistics",
    "verify": {
      "tables": [
        "admins",
        "billing_accounts",
        "billing_invoice_items",
        "billing_invoices",
        "billing_mandates",
        "billing_payment_attempts",
        "billing_subscriptions",
        "billing_webhook_events",
        "order_items",
        "orders",
        "plan_events",
        "products",
        "product_variants",
        "store_locations",
        "stores"
      ],
      "columns": [
        "billing_invoices.invoice_ref",
        "billing_invoices.status",
        "billing_mandates.provider_token_id",
        "billing_payment_attempts.idempotency_key",
        "billing_subscriptions.current_cycle_seq",
        "orders.fulfilment_type",
        "orders.location_id",
        "stores.plan"
      ]
    }
  },
  "migrations": [
    {
      "id": "20260814_0001_logistics_shiprocket",
      "description": "Shiprocket logistics, fulfilment orders, shipments, and immutable parcel snapshots",
      "file": "../../supabase/logistics_01_shiprocket.sql",
      "transaction": true,
      "requires": ["baseline:cloudsql-2026-08-14"],
      "verify": {
        "tables": [
          "fulfilment_order_items",
          "fulfilment_orders",
          "location_logistics_mappings",
          "shipment_events",
          "shipment_items",
          "shipments",
          "store_logistics_providers"
        ],
        "columns": [
          "order_items.height_cm",
          "order_items.length_cm",
          "order_items.requires_shipping",
          "order_items.sku",
          "order_items.weight_grams",
          "order_items.width_cm",
          "product_variants.requires_shipping",
          "product_variants.weight_grams",
          "products.requires_shipping",
          "products.weight_grams",
          "shipments.idempotency_key",
          "shipments.operation_lease_until"
        ],
        "constraints": [
          "product_variants_weight_nonnegative",
          "products_weight_nonnegative",
          "shipments_idempotency_key_key"
        ],
        "rlsTables": [
          "fulfilment_order_items",
          "fulfilment_orders",
          "location_logistics_mappings",
          "shipment_events",
          "shipment_items",
          "shipments",
          "store_logistics_providers"
        ]
      }
    },
    {
      "id": "20260814_0002_schema_drift_repair",
      "description": "Repair the production credit-note formatter and canonicalize the legacy scheduled-plan constraint",
      "file": "sql/20260814_0002_schema_drift_repair.sql",
      "transaction": true,
      "requires": ["20260814_0001_logistics_shiprocket"],
      "verify": {
        "constraints": ["store_subscriptions_scheduled_plan_check"],
        "functions": [
          "sm_credit_note_ref(integer,integer)",
          "sm_pad(integer,integer)"
        ],
        "queries": [
          {
            "name": "credit-note identifiers grow without truncating",
            "sql": "select public.sm_credit_note_ref(1001, 12345)",
            "equals": "CRN1001123452"
          },
          {
            "name": "existing-width credit-note identifiers are unchanged",
            "sql": "select public.sm_credit_note_ref(1001, 1)",
            "equals": "CRN100100015"
          }
        ]
      }
    },
    {
      "id": "20260816_0003_pos_pickup_prepared_at",
      "description": "Record actual pickup preparation separately from the checkout promise",
      "file": "sql/20260816_0003_pos_pickup_prepared_at.sql",
      "transaction": true,
      "requires": ["20260814_0002_schema_drift_repair"],
      "verify": {
        "columns": ["orders.pickup_prepared_at"]
      }
    },
    {
      "id": "20260816_0004_ai_credit_invoice_paid_repair",
      "description": "Mark paid one-time AI-credit invoices as paid instead of subscription debt",
      "file": "sql/20260816_0004_ai_credit_invoice_paid_repair.sql",
      "transaction": true,
      "requires": ["20260816_0003_pos_pickup_prepared_at"],
      "verify": {
        "queries": [
          {
            "name": "paid AI-credit purchases have no collectible invoice",
            "sql": "select count(*)::text from public.billing_invoices invoice join public.ai_credit_purchases purchase on purchase.invoice_id = invoice.id where purchase.status = 'paid' and invoice.kind = 'ai_credits' and invoice.status in ('draft', 'open', 'processing')",
            "equals": "0"
          }
        ]
      }
    },
    {
      "id": "20260818_0005_analytics_dashboard_layouts",
      "description": "Persist bounded personal Analytics dashboard layouts per store admin",
      "file": "../../supabase/analytics_01_dashboard_layouts.sql",
      "transaction": true,
      "requires": ["20260816_0004_ai_credit_invoice_paid_repair"],
      "verify": {
        "tables": ["analytics_dashboard_layouts"],
        "constraints": [
          "analytics_dashboard_layouts_layout_is_object",
          "analytics_dashboard_layouts_pkey",
          "analytics_dashboard_layouts_schema_version_check"
        ],
        "rlsTables": ["analytics_dashboard_layouts"]
      }
    },
    {
      "id": "20260819_0006_search_metrics",
      "description": "Persist tenant-safe Search Console source epochs, metric buckets, leased work, and fleet rate limits",
      "file": "../../supabase/search_metrics_01_schema.sql",
      "transaction": true,
      "requires": ["20260818_0005_analytics_dashboard_layouts"],
      "verify": {
        "tables": [
          "store_search_metrics",
          "store_search_rate_limits",
          "store_search_sources",
          "store_search_sync_jobs"
        ],
        "constraints": [
          "store_search_metrics_pkey",
          "store_search_metrics_source_store_fkey",
          "store_search_sources_id_store_key",
          "store_search_sync_jobs_pkey"
        ],
        "functions": ["claim_store_search_rate_slot(text,integer)"],
        "rlsTables": [
          "store_search_metrics",
          "store_search_rate_limits",
          "store_search_sources",
          "store_search_sync_jobs"
        ]
      }
    },
    {
      "id": "20260820_0007_platform_analytics_controls",
      "description": "Add operator-controlled Analytics availability and seed the first Analytics help documents",
      "file": "sql/20260820_0007_platform_analytics_controls.sql",
      "transaction": true,
      "requires": ["20260819_0006_search_metrics"],
      "verify": {
        "tables": ["platform_analytics_settings"],
        "constraints": [
          "platform_analytics_settings_id_check",
          "platform_analytics_settings_pkey"
        ],
        "rlsTables": ["platform_analytics_settings"],
        "queries": [
          {
            "name": "the Analytics help overview is published",
            "sql": "select count(*)::text from public.help_articles where slug = 'understand-analytics-dashboard' and status = 'published'",
            "equals": "1"
          }
        ]
      }
    },
    {
      "id": "20260820_0008_analytics_help_documents",
      "description": "Publish the complete Analytics Help Centre guide set and prepare detailed GA4 and Meta Pixel setup drafts",
      "file": "sql/20260820_0008_analytics_help_documents.sql",
      "transaction": true,
      "requires": ["20260820_0007_platform_analytics_controls"],
      "verify": {
        "queries": [
          {
            "name": "eight shipped Analytics guides are published",
            "sql": "select count(*)::text from public.help_articles where slug in ('understand-analytics-dashboard', 'analytics-terms-and-data-sources', 'analytics-sales-and-orders', 'analytics-customers-inventory-and-activity', 'understand-google-search-analytics', 'analytics-reports-and-csv', 'customize-analytics-dashboard', 'analytics-troubleshooting') and status = 'published'",
            "equals": "8"
          },
          {
            "name": "merchant pixel setup guides remain drafts",
            "sql": "select count(*)::text from public.help_articles where slug in ('connect-google-analytics-4', 'connect-meta-pixel') and status = 'draft'",
            "equals": "2"
          }
        ]
      }
    },
    {
      "id": "20260820_0009_help_article_indexability",
      "description": "Require every published Help article to have the category needed by its canonical URL",
      "file": "sql/20260820_0009_help_article_indexability.sql",
      "transaction": true,
      "requires": ["20260820_0008_analytics_help_documents"],
      "verify": {
        "constraints": ["help_articles_published_has_category"],
        "queries": [
          {
            "name": "no published Help article is missing its canonical category",
            "sql": "select count(*)::text from public.help_articles where status = 'published' and category_id is null",
            "equals": "0"
          }
        ]
      }
    },
    {
      "id": "20260820_0010_merchant_pixels",
      "description": "Enable Pro merchant GA4 and Meta Pixel modules and publish their consent-aware setup guides",
      "file": "sql/20260820_0010_merchant_pixels.sql",
      "transaction": true,
      "requires": ["20260820_0009_help_article_indexability"],
      "verify": {
        "queries": [
          {
            "name": "merchant pixel modules are globally available",
            "sql": "select count(*)::text from public.platform_analytics_settings where id = true and google_analytics_4 = true and meta_pixel = true",
            "equals": "1"
          },
          {
            "name": "merchant pixel setup guides are published",
            "sql": "select count(*)::text from public.help_articles where slug in ('connect-google-analytics-4', 'connect-meta-pixel') and status = 'published'",
            "equals": "2"
          }
        ]
      }
    }
  ]
}
