{
  "name": "wholesip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:webpack": "node scripts/dev-server.mjs --webpack",
    "dev:turbo": "node scripts/dev-server.mjs --turbopack",
    "dev:all:turbo": "concurrently -n proxy,next -c blue,green --kill-others-on-fail \"npm run db:proxy\" \"npm run dev:turbo\"",
    "dev:all:webpack": "concurrently -n proxy,next -c blue,green --kill-others-on-fail \"npm run db:proxy\" \"npm run dev:webpack\"",
    "dev:lean": "node scripts/dev-server.mjs --heap-mb=2048",
    "dev:full": "node scripts/dev-server.mjs --heap-mb=0",
    "dev:reset": "node scripts/dev-server.mjs --reset-cache",
    "db:proxy": "cloud-sql-proxy --port 6543 --run-connection-test storemink-prod:asia-south1:storemink-prod-db",
    "dev:all": "concurrently -n proxy,next -c blue,green --kill-others-on-fail \"npm run db:proxy\" \"npm run dev\"",
    "dev:all:lean": "concurrently -n proxy,next -c blue,green --kill-others-on-fail \"npm run db:proxy\" \"npm run dev:lean\"",
    "dev:all:full": "concurrently -n proxy,next -c blue,green --kill-others-on-fail \"npm run db:proxy\" \"npm run dev:full\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prettier": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:shuffle": "vitest run --coverage=false --sequence.shuffle --sequence.seed=20260813",
    "mink:eval": "node scripts/mink-eval.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:staging": "DB_ADMIN_USER=postgres DB_ADMIN_PASSWORD=\"$(gcloud secrets versions access latest --secret=CLOUDSQL_PROD_POSTGRES_PW --project=storemink-prod)\" DB_NAME=storemink_staging sh -c 'c=$1; shift; node scripts/db-migrate.mjs \"$c\" --environment staging \"$@\"' _",
    "db:migrate:prod": "DB_ADMIN_USER=postgres DB_ADMIN_PASSWORD=\"$(gcloud secrets versions access latest --secret=CLOUDSQL_PROD_POSTGRES_PW --project=storemink-prod)\" DB_NAME=storemink sh -c 'c=$1; shift; node scripts/db-migrate.mjs \"$c\" --environment production \"$@\"' _"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ],
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/cloud-sql-connector": "^1.11.2",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.19.0",
    "@tiptap/extension-code-block-lowlight": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-table": "3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@tiptap/suggestion": "^3.24.0",
    "@types/nodemailer": "^8.0.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.0",
    "isomorphic-dompurify": "^3.15.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^8.0.10",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-phone-number-input": "^3.4.17",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "sanitize-html": "^2.17.4",
    "shadcn": "^4.10.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
